{
  "schemaVersion": 1,
  "projectType": "node",
  "packageManager": "npm",
  "bootstrap": {
    "command": "npm ci"
  },
  "cache": {
    "hostPath": ".sandcastle/cache/npm",
    "sandboxPath": "/home/agent/.npm"
  },
  "rootPackage": {
    "cwd": ".",
    "focusedTestHint": "npm test -- <affected-test-files> --run",
    "authoritativeGates": [
      "npm run typecheck",
      "npm test",
      "npm run build",
      "node --test scripts/agent-map.browser.test.mjs"
    ]
  }
}
